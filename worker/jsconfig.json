{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "WebWorker"],
    "types": ["node"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "strict": false
  },
  "include": ["**/*.js", "../shared/**/*.js"],
  "exclude": ["**/*.test.mjs", "**/*.test.js", "node_modules"]
}
