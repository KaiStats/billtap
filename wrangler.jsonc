{
  // Cloudflare Worker with static assets.
  //
  // Cloudflare has retired Pages for new projects, so this app deploys as a
  // Worker: a build emits ./dist, then `npx wrangler deploy` uploads the assets
  // and the Worker in worker/index.js.
  //
  // Deploy with `npm run build:static`, not `npm run build`.
  //
  // build:static also prerenders the public routes to static HTML, which is what
  // lets a crawler's first fetch contain the actual copy instead of an empty
  // <div id="root">. Plain `npm run build` still produces a working site — the
  // Worker falls back to the SPA shell when no snapshot is present — it just
  // ships the SEO handicap that prerendering exists to remove.
  "name": "billtap",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-29",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // Deep links must boot the SPA rather than 404 — billtap.app/restaurants
    // from the flyer QR, and /r/<slug> from a table tent.
    "not_found_handling": "single-page-application",

    // Must stay `true`. Do not narrow it back to a path list.
    //
    // Two things depend on it. Obviously: /api/* would otherwise be answered by
    // the SPA fallback with index.html, and every API call — including the
    // Base44 data layer the whole app runs on — would silently return HTML
    // instead of JSON.
    //
    // Less obviously: "not_found_handling": "single-page-application" makes the
    // assets binding match *every* path, so with a narrower list the Worker is
    // never invoked for page requests at all. SPA_ROUTES and LEGACY_REDIRECTS in
    // worker/index.js — the real 404 statuses and the 301s — become unreachable
    // in production while still passing their unit tests, because those call the
    // Worker directly and never exercise this dispatch. worker/index.test.mjs
    // asserts this value for exactly that reason.
    "run_worker_first": true
  }
}
