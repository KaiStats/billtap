# Cache policy for the static assets.
#
# ── Why this file exists ─────────────────────────────────────────────────────
#
# There was none, and Cloudflare's default for Workers static assets is
# `Cache-Control: public, max-age=0, must-revalidate`. Correct for HTML and
# wrong for everything else here: a returning diner revalidated every hashed
# bundle, every icon and every image on every page load — a conditional request
# per file, waiting on a 304 that says nothing changed, on a restaurant's wifi.
#
# It also quietly undercut the chunk split in vite.config.js. That exists so a
# copy edit in App.jsx does not invalidate React, the router and framer-motion
# for people who already have them — but "already have them" only helps if the
# browser can use them without asking first. With must-revalidate it asked
# anyway, so the win was in bytes transferred and not in round trips, which on a
# phone at a table is the half that hurts.
#
# ── The rule ─────────────────────────────────────────────────────────────────
#
# Immutable only where the filename changes when the content does. Vite writes
# /assets/index-D_aMljtz.js — a content hash — so a new build is a new URL and
# the old one can be cached for a year with no way to go stale.
#
# Everything under /icons, /img and /video keeps its name across builds, so a
# year would mean a replaced logo never arriving. A day, revalidated after, is
# the compromise: fast for the visit, correct by tomorrow.
#
# HTML is deliberately absent. It carries the references to the hashed files, so
# caching it is how a browser ends up asking for a bundle that no longer exists.
# Cloudflare's default already revalidates it.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/video/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The two scripts index.html loads from the site root.
#
# They were split out of inline <script> blocks so the CSP could drop
# script-src 'unsafe-inline', and in moving they landed at the root of public/ —
# where no rule above matches them. So they fell through to the same
# `max-age=0, must-revalidate` default this file exists to correct: two
# conditional requests on every page load, on a restaurant's wifi, for two files
# a returning phone already has byte-for-byte. Both are `defer`, so neither
# holds up first paint — but fonts.js is what swaps the real typefaces in, so
# the round trip is visible as the moment the page stops looking like fallback.
#
# Not `immutable`, because unlike /assets/* these names do not change when the
# contents do — fonts.js has already shipped a bad version once, and a year of
# immutable would have made that permanent on every phone that fetched it. An
# hour fresh, then a day of serving the old copy while fetching the new one in
# the background, which is the same bargain the icons get and for the same
# reason.
/analytics.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/fonts.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# The service worker decides when every other cached thing is replaced, so it
# must never be the stale one. Browsers bypass the HTTP cache for the update
# check on their own now; saying so as well costs nothing and does not depend on
# which browser a diner brought.
/service-worker.js
  Cache-Control: no-cache

# Small, read once at install, and the thing that decides the app's name and
# icon on a home screen. Not worth caching past a revalidation.
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
