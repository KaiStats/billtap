# BillTap — configuration, per environment.
#
# Copy to .env.local for local work. Never commit a filled-in copy: .gitignore
# ignores every .env file except this template.
#
# ── The rule this file exists to enforce ────────────────────────────────────
#
# Development, staging and production must not share a Base44 app, a set of API
# keys, or anything else. There was a period where they shared all three: one
# BASE44_APP_ID, one master key, and `wrangler dev` writing live Session rows
# into real restaurants' bills.
#
# The app id is the database identity. A Base44 master key is scoped to one
# app, so pointing an environment at its own app is what actually separates the
# data — everything below follows from that.
#
# Guards that will stop you rather than let it happen quietly:
#   - worker/lib/environment.js refuses to serve when a non-production
#     deployment carries the production app id, or a live Stripe key.
#   - Email and SMS are logged instead of sent outside production.
#   - The nightly backup only runs in production.
#   - A badge is pinned to the top of every non-production screen.
#   - scripts/check-env.mjs fails the build before any of that matters.

# ── Required everywhere ─────────────────────────────────────────────────────

# production | staging | development. Unset is treated as development, which
# loses the crons rather than gaining a production database.
VITE_ENVIRONMENT=development

# The Base44 app this build talks to. NOT a secret — it ships in the bundle.
# Use a different app per environment. This is the whole mechanism.
VITE_BASE44_APP_ID=

# ── Worker secrets: `npx wrangler secret put NAME --env <environment>` ──────
#
# Listed here for documentation only. Do not put real values in a .env file
# that a build can read; the Worker gets them from wrangler.
#
#   BASE44_APP_ID            same value as VITE_BASE44_APP_ID
#   BASE44_MASTER_KEY        acts as the app, bypasses row-level security
#   QR_SIGNING_SECRET        HMAC key for QR tokens; falls back to the master key
#   STRIPE_SECRET_KEY        sk_test_... outside production. sk_live_ is refused.
#   STRIPE_PRICE_ID          the subscription price
#   REPORT_WEBHOOK_SECRET    guards the monthly report endpoint
#   POSTMARK_SERVER_TOKEN    or RESEND_API_KEY, for email
#   TWILIO_ACCOUNT_SID       Twilio, for the rating alert SMS
#   TWILIO_AUTH_TOKEN
#   TWILIO_FROM_NUMBER
#   LEAD_NOTIFY_TO           where restaurant leads are emailed
#   LEAD_NOTIFY_FROM
#   PUBLIC_BASE_URL          absolute origin, for links inside emails
#   ALLOW_OUTBOUND_MESSAGES  set to true ONLY to test real delivery off production

# ── Optional ────────────────────────────────────────────────────────────────

# Errors are tagged with VITE_ENVIRONMENT, so one project can serve all of them
# without a laptop's stack traces polluting the production feed.
VITE_SENTRY_DSN=

# Points the SDK at a Base44 proxy during local development.
VITE_BASE44_APP_BASE_URL=
