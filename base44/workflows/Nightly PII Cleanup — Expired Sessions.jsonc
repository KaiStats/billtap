{
  "name": "Nightly PII Cleanup \u2014 Expired Sessions",
  "description": "Purges guest names, claim associations, and receipt images from completed sessions settled more than 30 days ago.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nightly_pii_cleanup_expired_sessions",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "cleanupExpiredSessions",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}