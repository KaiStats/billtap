{
  "name": "Waitlist",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email"
    },
    "app": {
      "type": "string",
      "default": "billtap"
    },
    "source": {
      "type": "string",
      "default": "landing_page"
    },
    "created_at": {
      "type": "number",
      "description": "Unix timestamp ms"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}