{
  "name": "Session",
  "type": "object",
  "properties": {
    "receipt_id": {
      "type": "string",
      "description": "Linked receipt ID"
    },
    "title": {
      "type": "string"
    },
    "split_mode": {
      "type": "string",
      "enum": [
        "itemized",
        "even",
        "custom"
      ],
      "default": "itemized",
      "description": "How the bill is split: itemized (by items), even (equal), or custom (percentages/amounts)"
    },
    "items": {
      "type": "array",
      "description": "Line items with claims (itemized mode only)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "claimed_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tax": {
      "type": "number"
    },
    "tip": {
      "type": "number"
    },
    "total_amount": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "description": "People who joined",
      "items": {
        "type": "object",
        "properties": {
          "participant_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "amount_owed": {
            "type": "number"
          },
          "payment_status": {
            "type": "string",
            "enum": [
              "unpaid",
              "pending_verification",
              "paid"
            ],
            "default": "unpaid"
          },
          "split_percentage": {
            "type": "number",
            "description": "Percentage of total for custom split mode"
          },
          "split_amount": {
            "type": "number",
            "description": "Fixed amount for custom split mode"
          }
        }
      }
    },
    "host_payment_info": {
      "type": "object",
      "description": "Host's preferred payment method",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "venmo",
            "cashapp",
            "zelle"
          ]
        },
        "handle": {
          "type": "string",
          "description": "@username for Venmo/CashApp, phone/email for Zelle"
        }
      }
    },
    "expires_at": {
      "type": "number",
      "description": "Unix timestamp when session expires (30 days from creation)"
    },
    "restaurant_id": {
      "type": "string",
      "description": "Set when the host operates a BillTap restaurant. Drives the post-payment rating capture; absent on ordinary consumer splits."
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "claiming",
        "completed"
      ],
      "default": "waiting"
    },
    "custom_split_config": {
      "type": "object",
      "description": "Configuration for custom split mode (percentages or fixed amounts)",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "percentage",
            "amount"
          ]
        },
        "values": {
          "type": "object",
          "description": "Map of participant_id to percentage or amount"
        }
      }
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.participants.participant_id": "{{user.id}}"
        },
        {
          "data.participants.participant_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.participants.participant_id": "{{user.id}}"
        },
        {
          "data.participants.participant_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}