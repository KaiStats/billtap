{
  "name": "RestaurantLead",
  "type": "object",
  "properties": {
    "restaurant_name": {
      "type": "string",
      "description": "Business name as entered by the operator"
    },
    "contact_name": {
      "type": "string",
      "description": "Name of the person requesting the trial"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string",
      "description": "Digits only, normalized client-side"
    },
    "locations": {
      "type": "string",
      "description": "Rough number of locations: 1, 2-5, 6-20, 20+"
    },
    "plan_interest": {
      "type": "string",
      "default": "pilot",
      "description": "Which pricing tier the operator clicked through from"
    },
    "source": {
      "type": "string",
      "default": "restaurants_page",
      "description": "Attribution: restaurants_page, flyer_qr, etc."
    },
    "notified_at": {
      "type": "number",
      "description": "Unix ms when the alert email was accepted by Resend. Null means the lead was saved but the notification did not send."
    },
    "created_at": {
      "type": "number",
      "description": "Unix timestamp ms"
    }
  },
  "required": [
    "restaurant_name",
    "email"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}