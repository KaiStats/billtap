{
  "name": "billtap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm run test:unit && npm run test:ui",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "lint:report": "eslint .",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "build:static": "node scripts/check-env.mjs && vite build && node scripts/prerender.mjs",
    "build:ci": "node scripts/check-env.mjs && vite build && (playwright install chromium || true) && node scripts/prerender.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "deploy": "npm run build:static && wrangler deploy",
    "test:ui": "npm run build:test && node --test --test-concurrency=2 scripts/ui.browser.mjs",
    "check:env": "node scripts/check-env.mjs",
    "test:unit": "node --test worker/*.test.mjs src/*.test.mjs scripts/*.test.mjs",
    "build:test": "node scripts/build-for-tests.mjs",
    "check:wrangler": "node scripts/check-wrangler.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/react": "^8.55.2",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-query": "^5.84.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.16.4",
    "lucide-react": "^0.475.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0",
    "playwright": "^1.56.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.1.0",
    "wrangler": "^4.115.0"
  }
}
